* text=auto

# Keep code and container configuration portable across Windows and Linux.
*.py text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf

# Windows helper scripts may keep Windows line endings locally.
*.ps1 text eol=crlf

# Office documents and images are binary files.
*.docx binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
