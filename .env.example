# API keys
ADZUNA_APP_ID=replace_me
ADZUNA_APP_KEY=replace_me

# PostgreSQL data warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobmarket
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me

# Application services
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me

# Airflow automation
# Daily: @daily
# Weekly Monday 06:00: 0 6 * * 1
JOBMARKET_AIRFLOW_SCHEDULE=@daily

# Email alerting (optional)
# Gmail example: use smtp.gmail.com:587 with an App Password, never your account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_EMAIL=jobmarket@example.com
SMTP_FROM_NAME=JobMarket Alerting
SMTP_USE_TLS=true

# Local demo paths
BRONZE_PATH=data/local/bronze
SILVER_PATH=data/local/silver
GOLD_PATH=data/local/gold
QUALITY_REPORT_PATH=data/local/quality/quality_report.json
DATA_PROFILE_REPORT_PATH=data/local/profiling/data_profile.json
PIPELINE_RUNS_PATH=data/local/monitoring/pipeline_runs.jsonl
USER_PROFILE_PATH=configs/user_profile.json
EXTRACTION_PLAN_PATH=configs/extraction_plan.json
# EXTRACTION_PLAN_PATH=configs/extraction_plan_high_volume.json
HADOOP_HOME=replace_me
JOBMARKET_LOCAL_JAVA_HOME=replace_me

# Adzuna HTML description enrichment
ADZUNA_DESCRIPTION_BACKFILL_MAX_JOBS=50
ADZUNA_DESCRIPTION_BACKFILL_MIN_CHARS=900
ADZUNA_DESCRIPTION_BACKFILL_MAX_CHARS=20000
ADZUNA_DESCRIPTION_BACKFILL_THROTTLE_SECONDS=1.0
ADZUNA_DESCRIPTION_BACKFILL_TIMEOUT_SECONDS=8.0
ADZUNA_DESCRIPTION_BACKFILL_RETRIES=1
